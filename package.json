{
  "name": "job-ledger",
  "version": "0.1.0",
  "description": "Bookkeeping for scheduled LLM jobs: runs, refs, seen sets and atomic state, so the model only judges",
  "license": "MIT",
  "author": "Bill Baran",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wkbaran/job-ledger.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
